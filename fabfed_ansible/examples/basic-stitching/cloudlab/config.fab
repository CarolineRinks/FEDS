variable:
  - node_count:
      default: 1
  - cloulab_device:
      default: Cloudlab-Utah #CloudLab-Clemson            #Cloudlab-Utah    # Utah-Cloudlab-Powder
provider:
  - cloudlab:
      - cloudlab_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: cloudlab
  - fabric:
      - fabric_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: fabric
  - ansible:
      - ansible_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: ansible
config:
  - layer3:
      - layer3_config:
          subnet: 192.168.1.0/24
resource:
  - network:
      - cnet:
          provider: '{{cloudlab.cloudlab_provider }}'
          layer3: '{{ layer3.layer3_config }}'
          profile: das-fabfed-clem
      - fabric_network:
          provider: '{{ fabric.fabric_provider }}'
          layer3: '{{ layer3.layer3_config }}'
          stitch_with:
            - network: '{{ network.cnet }}'
              stitch_option:
                device_name: '{{ var.cloulab_device }}'
  - node:
      - cloudlab_node:
          provider: '{{ cloudlab.cloudlab_provider }}'
          network: '{{ network.cnet }}'
          count: 1
      - fabric_node:
          provider: '{{ fabric.fabric_provider }}'
          # image: default_rocky_8
          # nic_model: NIC_Basic
          network: '{{ network.fabric_network }}'
          count: 1
  - service:
      - cloudlab_service:
          provider: '{{ ansible.ansible_provider }}'
          node: '{{ node.cloudlab_node }}'
          playbook_path: /Users/sanjanadas/FedTestML/experiments/Fabric_Chi_Cloudlab/chi_main.yml
          count: 1
  

