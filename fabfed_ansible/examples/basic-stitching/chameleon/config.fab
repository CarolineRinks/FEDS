variable:
  - site:
      default: CHI@TACC #STAR
  - node_count:
      default: 0
provider:
  - fabric:
      - fabric_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: fabric
  - chi:
      - chi_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: chi
  - ansible:
      - ansible_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: ansible
config:
  - layer3:
      - my_layer:
          subnet: 192.168.101.0/24
resource:
  - network:
      - chi_network:
          provider: '{{ chi.chi_provider }}'
          layer3: '{{ layer3.my_layer }}'
          # interface:
          # - vlan:  # If need be select a vlan TACC ['3210-3499'] # STAR ['3300-3309'] 
      - fabric_network:
          provider: '{{ fabric.fabric_provider }}'
          layer3: '{{ layer3.my_layer }}'
          # bw: 10
          stitch_with:
            - network: '{{ network.chi_network }}'
              stitch_option:
                site: '{{ var.site }}'
  - node:
      - fabric_node:
          provider: '{{ fabric.fabric_provider }}'
          image: default_rocky_8
          network: '{{ network.fabric_network }}'
          count: 1
          nic_model: NIC_Basic
      - chi_node:
          provider: '{{ chi.chi_provider }}'
          image: CC-Ubuntu20.04
          network: '{{ network.chi_network }}'
          flavor: m1.medium
          count: 1
  - service:
      - dtn_service:
          provider: '{{ ansible.ansible_provider }}'
          node: ['{{ node.chi_node }}','{{node.fabric_node}}']
          playbook_path: /Users/sanjanadas/ansible_gen/AnsibleAutomation/playbook_step_master.yml
          profile: fabfed
          count: 0
