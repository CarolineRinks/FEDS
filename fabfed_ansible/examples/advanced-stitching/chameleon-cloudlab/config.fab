variable:
  - chi_site:
      default: TACC # STAR
  - cloulab_site:
      default: CLEM # UTAH
  - node_count:
      default: 1
provider:
  - cloudlab:
      - cloudlab_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: cloudlab
  - fabric:
      - fabric_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: fabric
  - chi:
      - chi_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: chi
  - ansible:
      - ansible_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: ansible
config:
  - layer3:
      - my_layer:
          subnet: 192.168.100.0/24
          gateway: 192.168.100.1
          ip_start: 192.168.100.100
          ip_end: 192.168.100.250
resource:
  - network:
      - cnet:
          provider: '{{cloudlab.cloudlab_provider }}'
          layer3: '{{ layer3.layer3_config }}'
      - fabric_network:
          provider: '{{ fabric.fabric_provider }}'
          layer3: '{{ layer3.layer3_config }}'
          stitch_with:
            - network: '{{ network.chi_network }}'
              stitch_option:
                site: TACC
            - network: '{{ network.cnet }}'
              stitch_option:
                site: CLEM
      - chi_network:
          provider: '{{ chi.chi_provider }}'
          name: stitch_net
          layer3: '{{ layer3.layer3_config }}'
  - node:
      - cloudlab_node:
          provider: '{{ cloudlab.cloudlab_provider }}'
          network: '{{ network.cnet }}'
          count: 1
      - chi_node:
          provider: '{{ chi.chi_provider }}'
          network: '{{ network.chi_network }}'
          count: 1
      - fabric_node:
          provider: '{{ fabric.fabric_provider }}'
          site: WASH
          network: '{{ network.fabric_network }}'
          count: 1

  - service:
      - chi_service:
          provider: '{{ ansible.ansible_provider }}'
          node: '{{ node.chi_node }}'
          playbook_path: /Users/sanjanadas/FEDS/experiments/Fabric_Chi_Cloudlab/chi_main.yml
          count: 1
      - cloudlab_service:
          provider: '{{ ansible.ansible_provider }}'
          node: '{{ node.cloudlab_node }}'
          playbook_path: /Users/sanjanadas/FEDS/experiments/Fabric_Chi_Cloudlab/cloudlab_main.yml
          count: 1
      - Fabric_service:
          provider: '{{ ansible.ansible_provider }}'
          node: '{{ node.fabric_node }}'
          playbook_path: /Users/sanjanadas/FEDS/experiments/Fabric_Chi_Cloudlab/fabric_main.yml
          count: 1
     
