provider:
-   fabric:
    -   fabric_provider:
            credential_file: ~/.fabfed/fabfed_credentials.yml
            profile: fabric
-   ansible:
    -   ansible_provider:
            credential_file: ~/.fabfed/fabfed_credentials.yml
            profile: ansible
-   chi:
    -   chi_provider:
            credential_file: ~/.fabfed/fabfed_credentials.yml
            profile: chi
-   cloudlab:
    -   cloudlab_provider:
            credential_file: ~/.fabfed/fabfed_credentials.yml
            profile: cloudlab
config:
-   layer3:
    -   mylayer:
            subnet: 192.168.1.0/24
-   policy:
    -   clnet_fabnet:
            producer: fabric
            consumer: cloudlab
            stitch_port:
                peer:
                    site: CLEM
                    device_name: CloudLab-Clemson
                    profile: CloudLab-Clemson
                    preference: 100
                    provider: fabric
                profile: das-fabfed-clem
                preference: 100
                provider: cloudlab
    -   chinet_fabnet:
            producer: fabric
            consumer: chi
            stitch_port:
                peer:
                    profile: Chameleon-TACC
                    site: TACC
                    device_name: Chameleon-TACC
                    preference: 100
                    provider: fabric
                profile: fabric
                site: CHI@TACC
                preference: 100
                provider: chi
resource:
-   network:
    -   fabnet:
            provider: "{{ fabric.fabric_provider }}"
            layer3: "{{ layer3.mylayer }}"
            stitch_with:
            -   network: "{{ network.clnet }}"
                stitch_option:
                    policy: "{{ policy.clnet_fabnet }}"
            -   network: "{{ network.chinet }}"
                stitch_option:
                    policy: "{{ policy.chinet_fabnet }}"
    -   chinet:
            provider: "{{ chi.chi_provider }}"
            layer3: "{{ layer3.mylayer }}"
    -   clnet:
            provider: "{{ cloudlab.cloudlab_provider }}"
            layer3: "{{ layer3.mylayer }}"
-   node:
    -   chi_node:
            provider: "{{ chi.chi_provider }}"
            network: "{{ network.chinet }}"
            count: 1
    -   fab_node:
            provider: "{{ fabric.fabric_provider }}"
            network: "{{ network.fabnet }}"
            count: 1
    -   cl_node:
            provider: "{{ cloudlab.cloudlab_provider }}"
            network: "{{ network.clnet }}"
            count: 1
-   service:
    -   Service2:
            playbook_path: Services/Service2/main.yaml
            provider: "{{ ansible.ansible_provider }}"
            node: "['{{ node.fab_node }}']"
    -   service1:
            playbook_path: Services/service1/main.yaml
            provider: "{{ ansible.ansible_provider }}"
            node: "['{{ node.chi_node }}', '{{ node.cl_node }}']"
